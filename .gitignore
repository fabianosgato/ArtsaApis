# Node artifact files
apis-app/node_modules/
apis-app/dist/
apis-app/vendor/
apis-app/public/vendor
apis-app/storage
apis-app/public/build
apis-app/.phpunit.result.cache
apis-app/.env
apis-app/.env.example


# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

